.{
    .name = .thread_pool,
    .version = "0.2.1",
    .fingerprint = 0x2b20b508067550d7,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Lazy otel dependency. Only fetched when `-Dwith_otel=true` is
        // passed to `zig build`. The `lazy = true` entry lets Zig skip
        // the fetch entirely under the default disabled build, which
        // keeps the dependency graph cycle-free (otel itself depends on
        // thread-pool transitively under `-Dotel_use_devnw_pool=true`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel#ee492166dfefc7914229979c933411e6da9e504e",
            .hash = "otel-0.1.0-B0v3lr2UMwA5qFJCa20OT-1huDPLm1sTIFD22PQBADDD",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "Makefile",
        ".gitlab-ci.yml",
        "src",
        "tests",
        "benchmarks",
        "examples",
        "docs",
        "scripts",
        "LICENSE",
        "README.md",
    },
}
