.{
    .name = .thread_pool,
    .version = "0.2.1",
    .fingerprint = 0x2b20b508067550d7,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // No external dependencies. Removed 2026-04-30: the otel observability
        // seam used to lazy-pull `gitlab.com/devnw/zig/otel`, but that created
        // a hard dependency cycle (otel itself transitively pulled thread-pool
        // back through `-Dotel_use_devnw_pool=true`).  Even though both ends
        // of the cycle were `lazy = true`, the cross-repo dep-graph detector
        // (geode/scripts/detect_diamond_deps.py) couldn't converge because
        // every commit on either side bumped the other's hash.  The seam was
        // collapsed into a permanent comptime no-op (`observability.enabled`
        // is now hardcoded `false`) — callers that want telemetry on
        // submit/run can wrap `ThreadPool.submit` directly.  See
        // `src/observability.zig` for the residual stub API.
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "Makefile",
        ".gitlab-ci.yml",
        "src",
        "tests",
        "benchmarks",
        "examples",
        "docs",
        "scripts",
        "LICENSE",
        "README.md",
    },
}
